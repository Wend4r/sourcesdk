if(NOT SOURCESDK_DIR)
	message(FATAL_ERROR "SOURCESDK_DIR is empty")
endif()

if(NOT SOURCESDK_TIER0_PERPROJECT_DIR)
	message(FATAL_ERROR "SOURCESDK_TIER0_PERPROJECT_DIR is empty")
endif()

set(SOURCESDK_TIER0_PERPROJECT_NAME "tier0_perproject")
set(SOURCESDK_TIER0_PERPROJECT_OUTPUT_NAME "${SOURCESDK_TIER0_PERPROJECT_NAME}")

set(SOURCESDK_TIER0_PERPROJECT_COMPILER_OPTIONS
	${SOURCESDK_COMPILER_OPTIONS}
)

set(SOURCESDK_TIER0_PERPROJECT_LINK_OPTIONS
	${SOURCESDK_LINK_OPTIONS}
)

set(SOURCESDK_TIER0_PERPROJECT_COMPILE_DEFINITIONS
	${SOURCESDK_COMPILE_DEFINITIONS}

	_LIB
)

if(SOURCESDK_CREATE_INTEFACE_OVERRIDE)
	list(APPEND SOURCESDK_TIER0_PERPROJECT_COMPILE_DEFINITIONS CREATE_INTEFACE_OVERRIDE)
endif()

set(SOURCESDK_TIER0_PERPROJECT_INCLUDE_DIRS
	${SOURCESDK_PUBLIC_DIR}/tier0
	${SOURCESDK_PUBLIC_DIR}/tier1
	${SOURCESDK_PUBLIC_DIR}
)

set(SOURCESDK_TIER0_PERPROJECT_SOURCE_FILES
	${SOURCESDK_TIER0_PERPROJECT_DIR}/bitbuf.cpp
	${SOURCESDK_TIER0_PERPROJECT_DIR}/concommandbase.cpp
	${SOURCESDK_TIER0_PERPROJECT_DIR}/convar.cpp
	${SOURCESDK_TIER0_PERPROJECT_DIR}/convarref.cpp
	${SOURCESDK_TIER0_PERPROJECT_DIR}/interface.cpp
	${SOURCESDK_TIER0_PERPROJECT_DIR}/singletons.cpp
)

add_library(${SOURCESDK_TIER0_PERPROJECT_NAME} STATIC ${SOURCESDK_TIER0_PERPROJECT_SOURCE_FILES})
add_library(${PROJECT_NAME}::${SOURCESDK_TIER0_PERPROJECT_NAME} ALIAS ${SOURCESDK_TIER0_PERPROJECT_NAME})

set_target_properties(${SOURCESDK_TIER0_PERPROJECT_NAME} PROPERTIES
	C_STANDARD 17
	C_STANDARD_REQUIRED ON
	C_EXTENSIONS OFF

	CXX_STANDARD 17
	CXX_STANDARD_REQUIRED ON
	CXX_EXTENSIONS OFF
)

set_target_properties(${SOURCESDK_TIER0_PERPROJECT_NAME} PROPERTIES OUTPUT_NAME ${SOURCESDK_TIER0_PERPROJECT_OUTPUT_NAME})

if(WINDOWS)
	if(SOURCESDK_MSVC_RUNTIME_LIBRARY)
		set_target_properties(${SOURCESDK_TIER0_PERPROJECT_NAME} PROPERTIES MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
	endif()
elseif(MACOS)
	set_target_properties(${SOURCESDK_TIER0_PERPROJECT_NAME} PROPERTIES OSX_ARCHITECTURES "x86_64")
endif()

target_compile_options(${SOURCESDK_TIER0_PERPROJECT_NAME} PUBLIC ${PLATFORM_COMPILE_OPTIONS} ${SOURCESDK_TIER0_PERPROJECT_COMPILER_OPTIONS})
target_link_options(${SOURCESDK_TIER0_PERPROJECT_NAME} PUBLIC ${PLATFORM_LINK_OPTIONS} ${SOURCESDK_TIER0_PERPROJECT_LINK_OPTIONS})

target_compile_definitions(${SOURCESDK_TIER0_PERPROJECT_NAME} PUBLIC ${PLATFORM_COMPILE_DEFINITIONS} ${SOURCESDK_TIER0_PERPROJECT_COMPILE_DEFINITIONS})
target_include_directories(${SOURCESDK_TIER0_PERPROJECT_NAME} PUBLIC ${PLATFORM_INCLUDE_DIRS} ${SOURCESDK_TIER0_PERPROJECT_INCLUDE_DIRS})
target_link_libraries(${SOURCESDK_TIER0_PERPROJECT_NAME} PUBLIC ${SOURCESDK_TIER1_NAME} ${SOURCESDK_TIER0_NAME})
