// Names are the SchemaAtomicTypeInfo_t records of CS2 1.41.8.8 (libschemasystem.so, libserver.so).
// kind: plain = Type_Atomic, t = Type_Atomic_T, tt = Type_Atomic_TT, i = Type_Atomic_I,
// collection = Type_Atomic_CollectionOfT, collection_fixed = the same with a fixed count argument
